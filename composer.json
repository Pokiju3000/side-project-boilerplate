{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pokiju3000/delivery-ops",
    "type": "project",
    "description": "Portfolio-safe Laravel demo for client delivery operations, planning, validation, budgets, imports, and diagnostics.",
    "keywords": ["laravel", "portfolio", "internal-tools", "operations"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.7",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^3.0",
        "socialiteproviders/microsoft-azure": "^5.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php artisan migrate --graceful --ansi",
            "cmd /c npm run build",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185\" \"php artisan serve\" \"php artisan queue:work --queue=default --tries=3 --timeout=0\"  --names=server,queue --kill-others"
        ],
        "final": [
            "Composer\\Config::disableProcessTimeout",
            "composer dump-autoload",
            "@php artisan optimize:clear --ansi",
            "@php artisan migrate --graceful --ansi",
            "@php artisan route:list --ansi",
            "@php artisan schedule:list --ansi",
            "cmd /c npm run build",
            "@php artisan queue:restart --ansi",
            "cmd /c npx concurrently -c \"#93c5fd,#fb7185,#facc15\" \"php artisan serve\" \"php artisan queue:work --queue=default --tries=3 --timeout=0\" \"php artisan schedule:work\" --names=server,queue,schedule --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "vendor/bin/phpunit"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
